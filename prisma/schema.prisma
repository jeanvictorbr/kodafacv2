generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output        = "../src/database/generated/client"
}

datasource db {
  provider = "postgresql"
  
}

model Faccao {
  guildId         String    @id
  nomeFac         String?
  isPremium       Boolean   @default(false)
  premiumVenceEm  DateTime?

  // Setup do RH / Diretoria
  canalDiretoria  String?
  cargoMembro     String?
  cargoRecrutador String?

  // Personalização da Vitrine
  vitrineTitulo   String?   @default("🪖 Recrutamento Aberto")
  vitrineDesc     String?   @default("Junte-se à nossa facção. Preencha o formulário e aguarde a avaliação da diretoria.")
  vitrineBanner   String?
  vitrineRodape   String?   @default("Sistema de Recrutamento")

  membros         Membro[]
}

model Membro {
  id          String   @id @default(uuid())
  guildId     String
  userId      String
  nomeRp      String?
  passaporte  String?
  cargo       String?
  advertencias Int     @default(0)
  createdAt   DateTime @default(now())
  
  faccao      Faccao   @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}