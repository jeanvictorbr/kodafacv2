generator client {
  provider = "prisma-client-js"
  output   = "../src/database/generated/client"
}

datasource db {
  provider = "postgresql"
}

model Faccao {
  guildId           String         @id
  nomeFac           String
  isPremium         Boolean        @default(false)
  premiumVenceEm    DateTime?
  canalRecrutamento String?        // Adicionamos a coluna para o canal da Diretoria!
  membros           Membro[]
}

model Membro {
  userId        String
  faccaoId      String
  xpFidelidade  Int      @default(0)
  advertencias  Int      @default(0)
  faccao        Faccao   @relation(fields: [faccaoId], references: [guildId], onDelete: Cascade)

  @@id([userId, faccaoId]) 
}

model ChaveVIP {
  keyCode String  @id
  dias    Int
  usada   Boolean @default(false)
}

model Recrutamento {
  id           String   @id @default(uuid())
  guildId      String   // Para saber de qual servidor é a ficha
  userId       String   
  nomeRp       String
  passaporte   String
  status       String   @default("PENDENTE") 
  recrutadorId String?  
  criadoEm     DateTime @default(now())
}