generator client {
  provider = "prisma-client-js"
  output   = "../src/database/generated/client"
}

datasource db {
  provider = "postgresql"
}

model Faccao {
  guildId        String    @id
  nomeFac        String
  isPremium      Boolean   @default(false)
  premiumVenceEm DateTime?
  membros        Membro[]
}

model Membro {
  userId       String
  faccaoId     String
  xpFidelidade Int    @default(0)
  advertencias Int    @default(0)
  faccao       Faccao @relation(fields: [faccaoId], references: [guildId], onDelete: Cascade)

  @@id([userId, faccaoId])
}

model ChaveVIP {
  keyCode String  @id
  dias    Int
  usada   Boolean @default(false)
}
